# Copy this file to .env and adjust for your machine:
#   cp .env.example .env
#
# docker-compose reads .env automatically for variable substitution in
# docker-compose.yml. The Go service itself reads the same variable names
# directly via internal/config (see cmd/discovery/main.go). Every
# configurable value the service has lives here — see CONTEXT.md D7.

# Port the discovery-service HTTP server listens on inside the
# container/process.
PORT=8080

# Host port docker-compose maps to the container's PORT. Change this if
# it collides with something else already running on your machine
# (see CONTEXT.md M1 note — 8080 was taken on the original dev machine,
# hence the non-default 8090 here).
HOST_PORT=8090

# HTTP client timeout (seconds) for the client used to deliver on_discover
# callbacks to a BAP's callback URL.
DISPATCH_CLIENT_TIMEOUT_SECONDS=10

# Per-delivery context deadline (seconds) for a single on_discover
# callback attempt.
DISPATCH_DELIVERY_TIMEOUT_SECONDS=10

# --- Background dispatch pool (internal/worker) — see CONTEXT.md D9 ---

# Number of goroutines delivering on_discover callbacks concurrently.
WORKER_POOL_SIZE=10

# How many pending on_discover deliveries may queue for a free worker
# before new ones are dropped (with a logged warning).
WORKER_QUEUE_SIZE=100

# --- HTTP server hardening — see CONTEXT.md D9 ---

# Maximum size (bytes) of a single /discover request body.
MAX_REQUEST_BODY_BYTES=1048576

# Time allowed to read request headers before the connection is dropped.
HTTP_READ_HEADER_TIMEOUT_SECONDS=5

# Time allowed to read the full request (headers + body).
HTTP_READ_TIMEOUT_SECONDS=10

# Time allowed to write the response.
HTTP_WRITE_TIMEOUT_SECONDS=10

# How long an idle keep-alive connection is kept open.
HTTP_IDLE_TIMEOUT_SECONDS=60

# How long graceful shutdown waits for in-flight HTTP requests and queued
# on_discover dispatch jobs to drain before giving up.
SHUTDOWN_TIMEOUT_SECONDS=15

# Docker's own grace period before it SIGKILLs the container on
# `docker compose stop/down`. This is a Compose/Docker-only setting — the
# Go binary never reads it — so keep it a few seconds ABOVE
# SHUTDOWN_TIMEOUT_SECONDS above, or our own graceful shutdown gets cut
# off by Docker before it finishes draining.
STOP_GRACE_PERIOD=20s

# --- Logging (logharbour, github.com/remiges-tech/logharbour) — CONTEXT.md D10 ---

# Minimum log priority to emit. Every HTTP hit (method/path/status/
# duration) is logged at Info regardless of this setting — LOG_LEVEL
# controls verbosity ABOVE that, and setting it to a debug tier
# (debug/debug0/debug1/debug2) additionally dumps the full parsed
# /discover request body for every hit.
# One of: debug2, debug1, debug0 (or "debug"), info, warn, err (or
# "error"), crit, sec. Default: info.
LOG_LEVEL=info

# --- Service identity — CONTEXT.md D13 ---
# This service's own registered Beckn subscriber id/URI. Stamped onto the
# on_discover response context (and any catalog entry that doesn't
# already declare its own bppId/bppUri) whenever an incoming /discover
# request doesn't already address a specific BPP — which is the common
# case for a network-wide discovery service. Leave blank until this
# service is actually registered on a network.
BPP_ID=
BPP_URI=

# Path appended to a BAP's context.bapUri to form the on_discover
# callback URL. Per spec, bapUri should already be the BAP's full
# registered subscriber base URL, so the default "/on_discover" is
# correct. Override this ONLY if a specific counterpart's registered
# bapUri is missing its actual receiver route prefix (observed with an
# ONIX bapTxnReceiver expecting "/bap/receiver/on_discover" — a
# registration problem on their side, not something to "fix" by guessing
# in code). This is a stopgap; see CONTEXT.md D14.
ON_DISCOVER_PATH=/on_discover

# --- Outbound request signing (Ed25519) — CONTEXT.md D15 ---
# Real BAPs reject callbacks with no Authorization header
# (AUT_SIGNATURE_MISSING) — this signs outbound on_discover requests per
# beckn.yaml's Signature format. Only active when BPP_ID above is set
# (signing without an identity is meaningless).
#
# SIGNING_PRIVATE_KEY_BASE64: base64-encoded 32-byte Ed25519 seed. Leave
# blank to generate a fresh EPHEMERAL key every process start — this
# stops a receiver rejecting a *missing* signature, but nobody can
# actually verify it (nothing has this key registered). Generate a real
# one with: `openssl rand -base64 32`, then have BPP_ID's public key
# published to your network's registry under SIGNING_KEY_ID before
# relying on the signature actually being verified.
SIGNING_PRIVATE_KEY_BASE64=

# The "{uniqueKeyId}" segment of the signature's keyId — must match
# whatever key id your public key is registered under.
SIGNING_KEY_ID=key-1

# How long a signature is valid for (created -> expires), in seconds.
SIGNING_VALIDITY_SECONDS=300

# --- Real catalog sources (internal/catalogsource) — CONTEXT.md D17 ---
# Comma-separated base URLs of BPP instances to poll for real catalog data
# via their existing dashboard API (GET /api/v1/catalogs,
# GET /api/v1/catalogs/{id} — no changes needed on the BPP side). Example:
# "http://bpp-application:8080" in Docker, a Cloud Run URL in production.
# Leave blank (the default) to keep serving the embedded M1 demo catalog
# (data/catalog.json) instead — this is a stopgap against an internal
# dashboard API, not a stable Beckn contract; see CONTEXT.md D17 for why.
CATALOG_SOURCE_URLS=

# How often each configured source is re-polled in the background after
# the initial fetch at startup.
CATALOG_REFRESH_INTERVAL_SECONDS=60

# Timeout for a single HTTP call (list or detail) to a catalog source.
CATALOG_FETCH_TIMEOUT_SECONDS=10

# --- Decentralized catalog crawler (internal/dedicrawl) — CONTEXT.md D18 ---
# Which catalog-ingestion mechanism to use: "dashboard" (default, the
# internal/catalogsource settings above) or "dedi" (the
# protocol-specifications-v2 §10 decentralized crawler). Leave as
# "dashboard" unless you specifically want to exercise the dedi path — it
# is opt-in precisely so switching it on never disrupts an existing
# dashboard-mode deployment.
CATALOG_SOURCE_MODE=dashboard

# Which dedicrawl.Registry backend "dedi" mode uses (see CONTEXT.md D21):
#   "fixture" (default) — DEDI_FIXTURE_PATH's self-signed dev/demo data,
#     no real registry involved. Safe, deterministic, always available.
#   "http" — a REAL DeDi registry (DEDI_REGISTRY_URL below). Confirmed
#     reachable at the default URL, but only useful once you have a real,
#     registered subscriberRef to put in DEDI_SUBSCRIBER_REFS below — a
#     real business's own DeDi onboarding (see e.g. an Ion reference-app
#     checkout's dedi-onboarding-files/ for what that onboarding process
#     produces), not something to invent.
DEDI_REGISTRY_MODE=fixture

# The real DeDi registry HTTPRegistry queries when DEDI_REGISTRY_MODE=http.
# This default is a real, live, confirmed-reachable public registry (a
# curl against it returns a proper 404 record-not-found for an unknown
# key) — only actually called when "http" mode is selected above.
DEDI_REGISTRY_URL=https://fabric.nfh.global/registry/dedi

# Comma-separated subscriber references to crawl.
#   fixture mode: leave blank to crawl every subscriber DEDI_FIXTURE_PATH
#     declares, or list a subset by the subscriberRef names inside it.
#   http mode: MUST be real, live nodeID(s) in "namespace/registry/recordName"
#     form, actually registered on DEDI_REGISTRY_URL — leaving this blank
#     in http mode means nothing to crawl (falls back to the embedded demo
#     catalog rather than an empty one).
DEDI_SUBSCRIBER_REFS=

# Only read in fixture mode — see internal/dedicrawl/fixture.go's doc
# comment: this is a local dev/demo harness, not a production integration.
# This is a relative path, resolved against the process's own working
# directory — under Docker, the Dockerfile copies internal/dedicrawl/testdata
# into the final image at the same relative location for exactly this reason.
DEDI_FIXTURE_PATH=

# Optional index-level scoping filters (comma-separated); leave both blank
# to accept every in-scope catalog index entry regardless of network/schema.
DEDI_NETWORK_IDS=
DEDI_SCHEMA_TYPES=

# §10.1 cutover rule: fetch a catalog's baseline instead of its
# accumulated change-file chain once the chain's combined size exceeds
# this fraction of the baseline size.
DEDI_CUTOVER_FRACTION=0.5

# --- Rate limiting & match timeout (internal/handlers, internal/service) — CONTEXT.md D20 ---
# Inbound /discover requests aren't authenticated yet (D15), and intent
# matching (D19) now does real per-request work — without a limit, nothing
# bounds how many requests, or how expensive a single filter, a caller can
# issue. Set to false only for local debugging; the defaults are generous
# enough for normal use.
RATE_LIMIT_ENABLED=false

# Sustained requests per second, and how many may burst instantaneously,
# allowed per client (keyed by remote address). Defaults are comfortably
# above any single real BAP's expected call rate or this demo's own
# catalogsource traffic pattern.
RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_BURST=10

# How long a single request's intent matching (textSearch/filters/spatial)
# may run before it's cut short and whatever's matched so far is returned.
# A filter is expected to complete in well under this.
MATCH_TIMEOUT_MILLISECONDS=500
